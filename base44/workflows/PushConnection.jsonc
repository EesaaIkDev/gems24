{
  "name": "Push: Network Requests",
  "description": "Notifies traders when they receive a network request or theirs is accepted",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Connection",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ (.trigger.event_type == \"create\" and .trigger.data.status == \"pending\") or (.trigger.event_type == \"update\" and .trigger.data.status == \"accepted\" and .trigger.old_data.status != \"accepted\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_connection",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushConnection",
            "args": {
              "connection_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify trader"
          }
        }
      }
    ]
  }
}