{
  "description": "Sends a push notification to the recipient when a chat message is sent",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_new_message",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushNewMessage",
            "args": {
              "message_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify recipient"
          }
        }
      }
    ]
  },
  "name": "Push: New Message",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Message"
    }
  }
}