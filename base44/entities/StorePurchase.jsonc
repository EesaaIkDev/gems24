{
  "name": "StorePurchase",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Store event id, used to make webhook delivery idempotent"
    },
    "trader_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "tier",
        "ignored"
      ],
      "description": "What the purchase granted"
    },
    "tier": {
      "type": "string"
    },
    "listings_granted": {
      "type": "number",
      "default": 0,
      "description": "Loyalty listing slots granted by this renewal"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "trader_name": {
      "type": "string",
      "description": "Snapshot of the buyer's name at purchase time"
    },
    "business_name": {
      "type": "string"
    },
    "trader_kind": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Price reported by the store"
    },
    "currency": {
      "type": "string"
    },
    "store": {
      "type": "string",
      "description": "App Store, Play Store, etc."
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}