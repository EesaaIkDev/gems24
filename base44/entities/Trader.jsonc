{
  "name": "Trader",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the owning app user"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "trader",
        "buyer"
      ],
      "default": "trader"
    },
    "full_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Free-text specialties entered by the trader"
    },
    "bio": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "none",
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "none"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Public verified badge. Set only by the verificationWebhook backend function on an approved decision \u2014 never writable by the client.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "require_message_approval": {
      "type": "boolean",
      "default": false,
      "description": "When true, other traders must be accepted before they can message this trader"
    },
    "signup_source": {
      "type": "string",
      "description": "How the trader heard about Gems24"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique short code this trader shares to invite others"
    },
    "referred_by_code": {
      "type": "string",
      "description": "Referral code this trader signed up with"
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "description": "Confirmed signups attributed to this trader, all time"
    },
    "referral_bonus_listings": {
      "type": "number",
      "default": 0,
      "description": "Extra active listing slots earned from referrals"
    },
    "referral_count_year": {
      "type": "number",
      "default": 0,
      "description": "Referrals used in the current 12-month window"
    },
    "referral_year_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the current 12-month referral window"
    },
    "purchased_listings": {
      "type": "number",
      "default": 0,
      "description": "Extra listing slots bought individually \u2014 never expire or reset"
    },
    "loyalty_years": {
      "type": "number",
      "default": 0,
      "description": "Consecutive subscription years without the plan lapsing. Set only by storeWebhook.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "loyalty_bonus_listings": {
      "type": "number",
      "default": 0,
      "description": "Free listing slots earned from uninterrupted annual renewals. Set only by storeWebhook; reset when the plan lapses.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}