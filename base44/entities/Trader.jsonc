{
  "name": "Trader",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the owning app user"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "trader",
        "buyer"
      ],
      "default": "trader"
    },
    "full_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Free-text specialties entered by the trader"
    },
    "bio": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "none",
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "none"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "require_message_approval": {
      "type": "boolean",
      "default": false,
      "description": "When true, other traders must be accepted before they can message this trader"
    },
    "signup_source": {
      "type": "string",
      "description": "How the trader heard about Gems24"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique short code this trader shares to invite others"
    },
    "referred_by_code": {
      "type": "string",
      "description": "Referral code this trader signed up with"
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "description": "Confirmed signups attributed to this trader, all time"
    },
    "referral_bonus_listings": {
      "type": "number",
      "default": 0,
      "description": "Extra active listing slots earned from referrals"
    },
    "referral_count_year": {
      "type": "number",
      "default": 0,
      "description": "Referrals used in the current 12-month window"
    },
    "referral_year_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the current 12-month referral window"
    },
    "purchased_listings": {
      "type": "number",
      "default": 0,
      "description": "Extra listing slots bought individually \u2014 never expire or reset"
    }
  },
  "required": [
    "full_name"
  ]
}