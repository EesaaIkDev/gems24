{
  "name": "Trader",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the owning app user",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.user_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "account_type": {
      "type": "string",
      "enum": [
        "trader",
        "buyer"
      ],
      "default": "trader",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        },
        "delete": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "description": "Chosen at signup. Afterwards only upgradeToTrader may change it (buyer -> trader, one way)."
    },
    "full_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Free-text specialties entered by the trader"
    },
    "bio": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "none",
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "none",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "plan_renews_at": {
      "type": "string",
      "format": "date-time",
      "description": "End of the current paid plan year, as reported by the store. Set only by storeWebhook.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "pending_tier": {
      "type": "string",
      "enum": [
        "",
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "",
      "description": "Lower grade the trader has switched to in the store; takes effect at plan_renews_at. Set only by storeWebhook.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "pending_tier_at": {
      "type": "string",
      "format": "date-time",
      "description": "When pending_tier takes effect. Set only by storeWebhook.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Public verified badge. Set only by the verificationWebhook backend function on an approved decision \u2014 never writable by the client.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "verified_as": {
      "type": "string",
      "enum": [
        "",
        "trader",
        "buyer"
      ],
      "default": "",
      "description": "Account type the verified badge was granted for, derived from the document checked. Set only by verificationWebhook; cleared by upgradeToTrader.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "phone": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.user_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "description": "Private: readable by the owner only. Never shown to other users."
    },
    "contact_email": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.user_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "description": "Private: owner only. Shared with accepted connections through connectedProfile."
    },
    "require_message_approval": {
      "type": "boolean",
      "default": false,
      "description": "When true, other traders must be accepted before they can message this trader"
    },
    "signup_source": {
      "type": "string",
      "description": "How the trader heard about Gems24"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique short code this trader shares to invite others"
    },
    "referred_by_code": {
      "type": "string",
      "description": "Referral code this trader signed up with",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "description": "Confirmed signups attributed to this trader, all time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referral_bonus_listings": {
      "type": "number",
      "default": 0,
      "description": "Extra active listing slots earned from referrals",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referral_count_year": {
      "type": "number",
      "default": 0,
      "description": "Referrals used in the current 12-month window",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referral_year_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the current 12-month referral window",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "purchased_listings": {
      "type": "number",
      "default": 0,
      "description": "Extra listing slots bought individually \u2014 never expire or reset",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "active_conversation_id": {
      "type": "string",
      "description": "Conversation the trader is currently viewing; used to mute pushes",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.user_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "active_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last presence heartbeat. Owner only; accepted connections read it through connectedProfile.",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.user_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "read_receipts": {
      "type": "boolean",
      "default": true,
      "description": "Share read receipts; when off the trader also can't see others' receipts"
    },
    "loyalty_years": {
      "type": "number",
      "default": 0,
      "description": "Consecutive subscription years without the plan lapsing. Set only by storeWebhook.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "loyalty_bonus_listings": {
      "type": "number",
      "default": 0,
      "description": "Free listing slots earned from uninterrupted annual renewals. Set only by storeWebhook; reset when the plan lapses.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}