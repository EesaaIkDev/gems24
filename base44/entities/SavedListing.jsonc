{
  "name": "SavedListing",
  "type": "object",
  "description": "A gemstone listing a signed-in user bookmarked. Private to that user.",
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "Id of the saved Listing"
    },
    "label": {
      "type": "string",
      "description": "Snapshot such as '1.05 ct Emerald', shown if the listing is later removed"
    }
  },
  "required": [
    "listing_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}