{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_a_id": {
      "type": "string",
      "description": "Trader id, lexicographically smaller of the pair",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "participant_b_id": {
      "type": "string",
      "description": "Trader id, lexicographically larger of the pair",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "participant_a_user_id": {
      "type": "string",
      "description": "App user id owning participant A. Set only by openConversation.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "participant_b_user_id": {
      "type": "string",
      "description": "App user id owning participant B. Set only by openConversation.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "context_label": {
      "type": "string",
      "description": "Where the chat was started from, e.g. '5.2 ct Sapphire'",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "context_path": {
      "type": "string",
      "description": "App path back to the listing or profile",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_message": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_sender_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "unread_a": {
      "type": "number",
      "default": 0
    },
    "unread_b": {
      "type": "number",
      "default": 0
    },
    "read_at_a": {
      "type": "string",
      "format": "date-time",
      "description": "When participant A last read the chat (only if they share read receipts)"
    },
    "read_at_b": {
      "type": "string",
      "format": "date-time",
      "description": "When participant B last read the chat (only if they share read receipts)"
    }
  },
  "required": [
    "participant_a_id",
    "participant_b_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.participant_a_user_id": "{{user.id}}"
        },
        {
          "data.participant_b_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.participant_a_user_id": "{{user.id}}"
        },
        {
          "data.participant_b_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.participant_a_user_id": "{{user.id}}"
        },
        {
          "data.participant_b_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}