{
  "name": "Verification",
  "type": "object",
  "description": "Per-trader identity verification state (Shufti Pro: KYC, KYB, AML). Written only by backend functions; the owner may read their own row. No document images are stored by Gems24.",
  "properties": {
    "trader_id": {
      "type": "string",
      "description": "Trader this verification state belongs to"
    },
    "user_email": {
      "type": "string",
      "description": "Owning user's email, used to scope reads to the owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "review",
        "resubmission_requested",
        "declined",
        "approved",
        "expired",
        "abandoned"
      ],
      "default": "none",
      "description": "Overall state. 'pending' = waiting on Shufti, 'review' = waiting on a Gems24 admin (e.g. an AML match), 'approved' = badge granted"
    },
    "document_type": {
      "type": "string",
      "description": "Legacy: document requested by the pre-Shufti manual flow"
    },
    "provider": {
      "type": "string",
      "description": "Verification provider for the current attempt: shufti (or manual for legacy rows)"
    },
    "provider_ref": {
      "type": "string",
      "description": "Shufti reference for the current attempt, used to match callbacks"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current submission was sent for checking"
    },
    "last_event_id": {
      "type": "string",
      "description": "Provider event/attempt id of the most recently applied decision, used to drop duplicate webhook deliveries"
    },
    "attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Lifetime count of verification attempts submitted by this trader"
    },
    "first_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the first attempt ever submitted"
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent submission, used for the cooldown window"
    },
    "last_decision_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent decision was applied"
    },
    "decline_reason": {
      "type": "string",
      "description": "Human-readable reason for a declined or resubmission_requested decision, shown to the trader"
    },
    "decline_reason_code": {
      "type": "number",
      "description": "Provider reason code for the most recent non-approval"
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "description": "True once the lifetime attempt cap is reached; only support can lift it"
    },
    "level": {
      "type": "string",
      "enum": [
        "",
        "buyer",
        "trader",
        "business"
      ],
      "default": "",
      "description": "Badge level the current attempt is for: buyer (KYC), trader (KYC + AML), business (KYB + KYC + AML)"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "passed",
        "failed",
        "review",
        "flagged"
      ],
      "default": "none"
    },
    "kyb_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "passed",
        "failed",
        "review",
        "flagged"
      ],
      "default": "none"
    },
    "aml_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "passed",
        "failed",
        "review",
        "flagged"
      ],
      "default": "none",
      "description": "'review' = match on the first screening, 'flagged' = match from ongoing monitoring after approval; both wait for an admin"
    },
    "verification_url": {
      "type": "string",
      "description": "Shufti hosted verification link for the pending attempt, so it can be resumed without a new (paid) request"
    },
    "verification_url_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_reason": {
      "type": "string",
      "description": "Why the account is waiting on an admin"
    },
    "reviewed_by": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "trader_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}