{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "listing_summary": {
      "type": "string"
    },
    "owner_trader_id": {
      "type": "string"
    },
    "enquirer_trader_id": {
      "type": "string"
    },
    "enquirer_name": {
      "type": "string"
    },
    "enquirer_email": {
      "type": "string"
    },
    "enquirer_phone": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "responded",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "listing_id",
    "owner_trader_id",
    "enquirer_name",
    "enquirer_email",
    "message"
  ]
}