{
  "name": "Connection",
  "type": "object",
  "properties": {
    "requester_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "requester_user_id": {
      "type": "string",
      "description": "App user id of the requester. Set only by requestConnection.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "recipient_user_id": {
      "type": "string",
      "description": "App user id of the recipient. Set only by requestConnection.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "pushed_status": {
      "type": "string",
      "description": "Last status pushConnection notified about, so each change is pushed once.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "requester_id",
    "recipient_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}